{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caelmor.invalid/schemas/gameplay-content",
  "title": "Additive playable content projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "tuning",
    "items",
    "skills",
    "targets",
    "actions",
    "quests",
    "enemies",
    "exclusiveFlags",
    "hazards",
    "flocks",
    "respawnRegions",
    "presentationEvents",
    "gates",
    "traps",
    "arenas"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "tuning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "health",
        "damage",
        "attackTicks",
        "respawnX",
        "respawnZ"
      ],
      "properties": {
        "health": {
          "type": "integer",
          "minimum": 1
        },
        "damage": {
          "type": "integer",
          "minimum": 1
        },
        "attackTicks": {
          "type": "integer",
          "minimum": 1
        },
        "respawnX": {
          "type": "number"
        },
        "respawnZ": {
          "type": "number"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "quests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/quest"
      }
    },
    "enemies": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/enemy"
      }
    },
    "exclusiveFlags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "flags"
        ],
        "properties": {
          "flags": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "hazards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hazard"
      }
    },
    "flocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flock"
      }
    },
    "respawnRegions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/respawnRegion"
      }
    },
    "presentationEvents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/presentationEvent"
      }
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/gate"
      },
      "type": "array"
    },
    "traps": {
      "items": {
        "$ref": "#/$defs/trap"
      },
      "type": "array"
    },
    "arenas": {
      "items": {
        "$ref": "#/$defs/arena"
      },
      "type": "array"
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "heal",
        "quest",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "heal": {
          "type": "integer",
          "minimum": 0
        },
        "quest": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "thresholds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "thresholds": {
          "type": "array",
          "minItems": 99,
          "maxItems": 99,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "x",
        "z",
        "all",
        "none",
        "nodeInstanceId",
        "y"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "all": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "none": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "nodeInstanceId": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "number"
        }
      }
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "count"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "objective",
        "all",
        "any",
        "anyCount",
        "counterRequirements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "all": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "any": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "anyCount": {
          "type": "integer",
          "minimum": 0
        },
        "counterRequirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/counterRequirement"
          }
        }
      }
    },
    "quest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "stages",
        "all",
        "startAll"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "all": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "startAll": {
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "type": "array"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "label",
        "text",
        "kind",
        "quest",
        "minStage",
        "maxStage",
        "all",
        "none",
        "any",
        "anyCount",
        "once",
        "ticks",
        "cooldown",
        "tool",
        "inputs",
        "outputs",
        "flags",
        "skill",
        "xp",
        "carry",
        "requiresCarry",
        "removeItems",
        "conditionalOutputs",
        "tagInputs",
        "flock",
        "flockOperation",
        "counterEffects",
        "trap",
        "trapOperation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "enter",
            "dialogue",
            "inspect",
            "channel",
            "gather",
            "craft",
            "lift",
            "deliver",
            "consume"
          ]
        },
        "quest": {
          "type": "string"
        },
        "minStage": {
          "type": "integer"
        },
        "maxStage": {
          "type": "integer"
        },
        "all": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "none": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "any": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "anyCount": {
          "type": "integer",
          "minimum": 0
        },
        "once": {
          "type": "string"
        },
        "ticks": {
          "type": "integer",
          "minimum": 0
        },
        "cooldown": {
          "type": "integer",
          "minimum": 0
        },
        "tool": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/amount"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/amount"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "skill": {
          "type": "string"
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "carry": {
          "type": "string"
        },
        "requiresCarry": {
          "type": "string"
        },
        "removeItems": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "conditionalOutputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conditionalAmount"
          }
        },
        "tagInputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tagAmount"
          }
        },
        "flock": {
          "type": "string"
        },
        "flockOperation": {
          "enum": [
            "",
            "prepare",
            "resolve",
            "recover"
          ]
        },
        "counterEffects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/counterEffect"
          }
        },
        "trap": {
          "type": "string"
        },
        "trapOperation": {
          "enum": [
            "",
            "inspect",
            "disarm"
          ]
        }
      }
    },
    "enemy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "all",
        "none",
        "health",
        "damage",
        "windup",
        "cooldown",
        "range",
        "leash",
        "killFlag",
        "respawn",
        "lootAction",
        "boundaryTarget",
        "boundaryRadius",
        "spawnFrom",
        "spawnHealthPercent",
        "spawnWindupTicks",
        "moveSpeed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "all": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "none": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "health": {
          "type": "integer",
          "minimum": 1
        },
        "damage": {
          "type": "integer",
          "minimum": 1
        },
        "windup": {
          "type": "integer",
          "minimum": 1
        },
        "cooldown": {
          "type": "integer",
          "minimum": 1
        },
        "range": {
          "type": "number"
        },
        "leash": {
          "type": "number"
        },
        "killFlag": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "respawn": {
          "type": "integer",
          "minimum": 0
        },
        "lootAction": {
          "type": "string"
        },
        "boundaryTarget": {
          "type": "string"
        },
        "boundaryRadius": {
          "type": "number",
          "minimum": 0
        },
        "spawnFrom": {
          "type": "string"
        },
        "spawnHealthPercent": {
          "minimum": 0,
          "type": "integer",
          "maximum": 100
        },
        "spawnWindupTicks": {
          "minimum": 0,
          "type": "integer"
        },
        "moveSpeed": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "conditionalAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "count",
        "all",
        "none"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "all": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "none": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hazard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "all",
        "none",
        "once",
        "windup",
        "damage",
        "radius",
        "pushDistance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "all": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "none": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "once": {
          "type": "string",
          "minLength": 1
        },
        "windup": {
          "type": "integer",
          "minimum": 1
        },
        "damage": {
          "type": "integer",
          "minimum": 1
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pushDistance": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "tagAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "count"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "flock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "alternateTarget",
        "coverTarget",
        "recoveryTarget",
        "closedTarget",
        "all",
        "none",
        "alertRadius",
        "coverRadius",
        "closedRadius",
        "warningTicks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "alternateTarget": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "coverTarget": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "recoveryTarget": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "closedTarget": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "all": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "none": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "alertRadius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "coverRadius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "closedRadius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "warningTicks": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "respawnRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "x",
        "z",
        "radius",
        "all",
        "none",
        "y"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "all": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "none": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "y": {
          "type": "number"
        }
      }
    },
    "presentationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "triggerFlag",
        "kind",
        "ticks",
        "rise",
        "persistRise"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "triggerFlag": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "ticks": {
          "type": "integer",
          "minimum": 1
        },
        "persistRise": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "waterRise",
            "quiet"
          ]
        },
        "rise": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "counterEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "amount"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "amount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "counterRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "min"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "min": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "yaw",
        "width",
        "height",
        "depth",
        "openAll",
        "openNone"
      ],
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "type": "string"
        },
        "yaw": {
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "depth": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "openAll": {
          "uniqueItems": true,
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "openNone": {
          "uniqueItems": true,
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      }
    },
    "trap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "yaw",
        "width",
        "depth",
        "all",
        "none",
        "warningTicks",
        "damage",
        "staggerTicks",
        "rearmTicks",
        "activeTicks",
        "slowPermille",
